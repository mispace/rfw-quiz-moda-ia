# ============================================
# Assistente WhatsApp — variáveis de ambiente
# ============================================
# Copie para um arquivo chamado ".env" e preencha.
# NUNCA comite o .env de verdade (ele está no .gitignore).

# -----------------------------------------------
# 1. ANTHROPIC_API_KEY  (OBRIGATÓRIO para o cérebro funcionar)
#    Onde obter: https://console.anthropic.com -> API Keys
#    Dica de custo: configure um TETO de gasto em Billing -> Limits.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Modelo do Claude. Comece com Haiku (barato). Suba para Sonnet se precisar
# de mais inteligência. Opus só para casos complexos.
#   Haiku  -> claude-haiku-4-5-20251001   (mais barato)
#   Sonnet -> claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------
# 2. TRELLO  (OPCIONAL — sem isso, o assistente roda em MODO SIMULADO
#    e apenas finge que cria os cards, ótimo para testar o fluxo)
#    Onde obter a key: https://trello.com/app-key
#    O token você gera na mesma página (botão "Token").
TRELLO_KEY=
TRELLO_TOKEN=
# ID da lista do Trello onde os cards entram por padrão.
# (Como descobrir: abra o board, adicione .json no fim da URL e procure o id da lista.)
TRELLO_LISTA_PADRAO=

# -----------------------------------------------
# 3. WHATSAPP  (só será usado na FASE 2 — não precisa agora)
#    Tudo isso vem do Meta for Developers.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
